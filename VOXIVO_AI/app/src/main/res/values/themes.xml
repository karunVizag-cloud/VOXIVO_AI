<resources>
    <style name="Theme.VOXIVOAI" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowBackground">@color/dark_background</item>
    </style>

    <style name="Theme.VOXIVOAI.Alarm" parent="Theme.VOXIVOAI">
        <item name="android:windowShowWhenLocked">true</item>
        <item name="android:windowTurnScreenOn">true</item>
        <item name="android:windowKeepScreenOn">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
